# 服务器配置
PORT=3000
NODE_ENV=development

# 可信反向代理配置（用于解析客户端真实 IP）
# false: 直连部署，不信任任何代理头
# true:  信任所有代理（仅限内网环境）
# 也可填 IP / CIDR 列表，如 10.0.0.0/8,192.168.1.0/24
TRUST_PROXY=loopback, linklocal, uniquelocal

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=clothing_shop

# JWT密钥
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# 微信小程序配置
WECHAT_APP_ID='wxca068873bf89e43f'
WECHAT_APP_SECRET=your_wechat_app_secret

# 支付配置（可选）
PAY_MCH_ID=your_merchant_id
PAY_API_KEY=your_api_key
PAY_NOTIFY_URL=http://yourdomain.com/api/payment/notify

# 文件上传配置
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
